# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM
#
# No LLM provider key is required: BAKAR_LLM=livekit (provider block below)
# routes every model call through LiveKit's inference gateway, which needs
# only the LiveKit keys above.
# -----------------------------------------------------------------------------
# Not used by any agent any more — the main agent defaults to LiveKit
# inference and the telephony agents share the same BAKAR_LLM selection.
# GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# LLM provider
#
# livekit (default) routes through LiveKit's inference gateway — nothing beyond
# the LiveKit keys above is required.
# selora uses any OpenAI-compatible gateway; activate the account first, or
# every model call returns 402 trial_not_activated.
# -----------------------------------------------------------------------------
BAKAR_LLM=livekit
BAKAR_LLM_MODEL=openai/gpt-4o-mini
# SELORA_API_KEY=
# SELORA_BASE_URL=https://api.selora.lol/v1

# -----------------------------------------------------------------------------
# Agent dispatch name (optional)
# Defaults to bakar-agent. Must match AGENT_NAME in the frontend that should
# reach this worker. Use a different value (e.g. bakar-agent-dev) to run a
# local worker beside a deployed one without the two competing for jobs.
# -----------------------------------------------------------------------------
# AGENT_NAME=bakar-agent

# -----------------------------------------------------------------------------
# Telephony (optional — only needed for src/telephony/)
# See src/telephony/README.md for the full setup.
# -----------------------------------------------------------------------------
# Required for outbound calls. Create the trunk with:
#   lk sip outbound create src/telephony/outbound/outbound-trunk.json
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_your_trunk_id

# Optional — where the transfer_to_human tool sends callers.
# TRANSFER_TO_NUMBER=+15551234567
