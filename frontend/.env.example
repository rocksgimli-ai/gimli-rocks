# =============================================================================
# Frontend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport — must match your backend agent's LiveKit project)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Agent dispatch (required)
#
# The backend registers its agent with a dispatch name (`agent_name` in
# backend/src/agent.py), and LiveKit only auto-dispatches agents that have *no*
# dispatch name. If this is empty the token carries no dispatch request: the page
# connects to an empty room, and the user hears nothing.
#
# Must match `agent_name` in the backend agent you are running.
# Tip: while a deployed worker exists, run your local worker as
# AGENT_NAME=bakar-agent-dev so the two never receive each other's jobs.
# -----------------------------------------------------------------------------
AGENT_NAME=bakar-agent

# -----------------------------------------------------------------------------
# Optional — LiveKit Cloud Sandbox / custom app config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
# SANDBOX_ID=

# Optional — switches the client to LiveKit's sandbox token source instead of
# this app's /api/token route (components/app/app.tsx). When set, the browser
# POSTs for connection details at this URL (X-Sandbox-Id header, room_config
# carrying agent_name) — used by LiveKit Cloud Sandbox templates only.
# NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=
